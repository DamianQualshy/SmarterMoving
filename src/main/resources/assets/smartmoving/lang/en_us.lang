#===========#
# Key Names #
#===========#

key.climb=Grab
key.config.toggle=Change Configuration
key.speed.increase=Increase Speed
key.speed.decrease=Decrease Speed
key.categories.smartmoving=Smarter Moving



#====================================#
# Configuration change chat messages #
#====================================#

# Used to announce whether a global or local Smarter Moving configuration is used
move.config.chat.server.global.unnamed=Using Smarter Moving server configuration
move.config.chat.server.global.named=Using Smarter Moving server configuration '%s'
move.config.chat.server.local=Using local Smarter Moving configurations

# Used when the Smarter Moving configuration is changed by the server
move.config.chat.server.disable=Smarter Moving was disabled by the server configuration
move.config.chat.server.update.named=Smarter Moving server configuration was set to '%s'
move.config.chat.server.update.unnamed=Smarter Moving server configuration was updated
move.config.chat.server.enable=Smarter Moving was enabled by the server configuration

# Used when the Smarter Moving configuration is changed by another player
move.config.chat.server.disable.user=Smarter Moving disabled by '%s'
move.config.chat.server.update.named.user=Smarter Moving set to '%s' by '%s'
move.config.chat.server.update.unnamed.user=Smarter Moving server configuration was updated by '%s'
move.config.chat.server.enable.user=Smarter Moving enabled by '%s'

# Used when a player with no rights tries to change the Smarter Moving configuration
move.config.chat.server.illegal.remote=You have no rights to change the Smarter Moving configuration on the remote server.
move.config.chat.server.illegal.local=You have no rights to change the Smarter Moving configuration on your local server.

# Used when a player changes the Smarter Moving configuration for himself alone
move.config.chat.client.disabled=Smarter Moving disabled
move.config.chat.client.enabled=Smarter Moving enabled
move.config.chat.client.unnamed=Smarter Moving set to key '%s'
move.config.chat.client.named=Smarter Moving set to '%s'
move.config.chat.client.help=(switch by pressing '%s')

# Used when a player changes the Smarter Moving configuration for everybody
move.config.chat.client.everyone.disabled=Smarter Moving disabled for all players
move.config.chat.client.everyone.enabled=Smarter Moving enabled for all players
move.config.chat.client.everyone.unnamed=Smarter Moving set to key '%s' for all players
move.config.chat.client.everyone.named=Smarter Moving set to '%s' for all players



#============================#
# Speed change chat messages #
#============================#

# Used when the Smarter Moving speed is changed by another player
move.speed.chat.server.change=Smarter Moving speed changed to %s%% by '%s'
move.speed.chat.server.reset=Smarter Moving speed changed to 100%% by '%s'

# Used when a player with no rights tries to change the Smarter Moving speed
move.speed.chat.server.illegal.remote=You have no rights to change the Smarter Moving speed on the remote server.
move.speed.chat.server.illegal.local=You have no rights to change the Smarter Moving speed on your local server.

# Used when a player changes the Smarter Moving speed for himself alone
move.speed.chat.client.init=Smarter Moving speed is %s%%
move.speed.chat.client.help=(increase speed by pressing '%s', decrease by pressing '%s')
move.speed.chat.client.change=Smarter Moving speed changed to %s%%
move.speed.chat.client.reset=Smarter Moving speed changed to 100%%

# Used when a player changes the Smarter Moving speed for everybody
move.speed.chat.client.everyone.change=Smarter Moving speed changed to %s%% for all players
move.speed.chat.client.everyone.reset=Smarter Moving speed changed to 100%% for all players